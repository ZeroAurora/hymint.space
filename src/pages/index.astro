---
import Layout from '@/layouts/Layout.astro'
import HighlightedWord from '@/components/HighlightedWord.astro'
---

<Layout title="Hydrated Minty Space">
  <div class="bg-gray-50 font-display h-screen w-screen flex flex-col justify-center items-center p-4 select-none">
    <header class="text-sm text-neutral-500 w-full flex justify-end gap-4">
      <div><a href="/about">About</a></div>
      <div><a href="https://github.com/ZeroAurora">GitHub</a></div>
    </header>
    <main class="text-7xl text-teal-500 font-bold w-full max-w-4xl flex flex-col flex-grow justify-center gap-8">
      <HighlightedWord text="Hydrated" />
      <HighlightedWord text="Minty" />
      <HighlightedWord text="Space" />
    </main>
    <footer class="text-sm text-neutral-500">Powered by ZeroAurora</footer>
  </div>
</Layout>
